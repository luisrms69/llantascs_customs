  "letter_head": "Letter head Llantascs",
  "modified": "2025-09-03 12:38:01.440420",
  "module": "Llantascs Customs",
  "name": "Pagos OPC - Por Sucursal",
  "prepared_report": 0,
  "query": "\nSELECT\n  x.cc_label                              AS \"Sucursal (Cost Center):Data:220\",\n  x.total_commission                      AS \"Total Comisiones:Currency:140\",\n  x.opc_count                             AS \"# OPCs:Int:80\",\n  x.invoice_count                         AS \"# Facturas:Int:100\"\nFROM (\n  SELECT\n    IFNULL(si.cost_center,'TOTAL')        AS cc_label,\n    ROUND(SUM(c.total_comision), 2)       AS total_commission,\n    COUNT(DISTINCT c.parent)              AS opc_count,\n    COUNT(DISTINCT c.sales_invoice_id)    AS invoice_count\n  FROM `tabComision LLCS` c\n  INNER JOIN `tabOrden de Pago Comisiones` opc ON opc.name = c.parent AND opc.docstatus = 1\n  INNER JOIN `tabSales Invoice` si ON si.name = c.sales_invoice_id AND si.docstatus = 1\n  WHERE si.posting_date >= %(from_date)s\n    AND si.posting_date <= %(to_date)s\n  GROUP BY si.cost_center WITH ROLLUP\n) x\nORDER BY (x.cc_label = 'TOTAL'), x.cc_label;\n",
  "ref_doctype": "Orden de Pago Comisiones",
  "reference_report": null,
  "report_name": "Pagos OPC - Por Sucursal",
  "report_script": null,
