 "query": "SELECT\nposting_date AS \"Fecha de Pago\", sum(paid_amount) AS \"Total Pagado\" , cost_center AS \"Sucursal\"\nFROM \n`tabPayment Entry`\nWHERE\ndocstatus=1\nAND\nposting_date between %(fecha_inicio)s and %(fecha_final)s\nAND\npayment_type='Receive'\nAND\ncost_center=%(sucursal)s\nGROUP BY posting_date;",
